<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CupForge — Template Generator</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:wght@400;500&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
:root {
  --ink:#0a0a0a; --paper:#f5f2ed; --warm:#f0ebe3; --mid:#c8c0b4;
  --faint:#e8e2d9; --accent:#c8441a; --cut:#c8441a; --bleed:#2d7a4f; --glue:#1a5fa8;
  --mono:'DM Mono',monospace; --display:'Bebas Neue',sans-serif; --body:'DM Sans',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{background:var(--paper);color:var(--ink);font-family:var(--body);display:grid;grid-template-rows:56px 1fr;grid-template-columns:320px 1fr;height:100vh}

/* HEADER */
header{grid-column:1/-1;background:var(--ink);color:var(--paper);padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid var(--accent);overflow:hidden;position:relative}
header::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent,transparent 60px,rgba(255,255,255,.02) 60px,rgba(255,255,255,.02) 61px);pointer-events:none}
.logo{font-family:var(--display);font-size:26px;letter-spacing:3px;line-height:1}
.logo-accent{color:var(--accent)}
.tagline{font-family:var(--mono);font-size:9px;color:var(--mid);letter-spacing:2px;text-transform:uppercase;margin-left:12px;padding-bottom:1px}
.badges{display:flex;gap:8px}
.badge{font-family:var(--mono);font-size:9px;letter-spacing:1px;text-transform:uppercase;color:var(--mid);border:1px solid #333;padding:3px 7px;border-radius:2px}

/* SIDEBAR */
.sidebar{background:var(--warm);border-right:1px solid var(--faint);display:flex;flex-direction:column;overflow-y:auto}
.sidebar-inner{padding:1.2rem;display:flex;flex-direction:column;gap:0;min-height:100%}
.section{padding:1rem 0;border-bottom:1px solid var(--faint)}
.section:last-child{border-bottom:none}
.sec-header{display:flex;align-items:center;gap:8px;margin-bottom:.8rem}
.sec-num{font-family:var(--display);font-size:18px;color:var(--accent);line-height:1;min-width:18px}
.sec-title{font-family:var(--mono);font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#666}
.field{margin-bottom:.7rem}
.field:last-child{margin-bottom:0}
.field label{display:flex;justify-content:space-between;align-items:baseline;font-size:11px;color:#555;margin-bottom:4px}
.field label .unit{font-family:var(--mono);font-size:9px;color:var(--accent);letter-spacing:1px}
.field input[type=number]{width:100%;background:white;border:1px solid var(--faint);border-radius:3px;padding:8px 10px;font-size:14px;font-family:var(--mono);color:var(--ink);-moz-appearance:textfield;transition:border-color .15s,box-shadow .15s;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.field input::-webkit-inner-spin-button,.field input::-webkit-outer-spin-button{-webkit-appearance:none}
.field input::placeholder{color:#ccc;font-size:12px;font-style:italic}
.field input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(200,68,26,.1)}

.btn-generate{width:100%;padding:13px;background:var(--ink);color:var(--paper);border:none;border-radius:3px;font-family:var(--display);font-size:15px;letter-spacing:3px;cursor:pointer;position:relative;overflow:hidden;transition:background .2s}
.btn-generate::after{content:'';position:absolute;left:0;bottom:0;width:100%;height:3px;background:var(--accent);transform:scaleX(0);transform-origin:left;transition:transform .25s ease}
.btn-generate:hover{background:#1a1a1a}
.btn-generate:hover::after{transform:scaleX(1)}
.btn-generate:active{transform:scale(.99)}
.btn-dl{width:100%;padding:9px;background:transparent;color:var(--ink);border:1px solid var(--ink);border-radius:3px;font-family:var(--mono);font-size:10px;letter-spacing:2px;text-transform:uppercase;cursor:pointer;margin-top:6px;transition:background .15s,color .15s;display:none}
.btn-dl:hover{background:var(--ink);color:var(--paper)}
.errmsg{background:#fff0ed;border-left:3px solid var(--accent);padding:8px 10px;font-size:11px;color:var(--accent);display:none;border-radius:0 3px 3px 0;margin-bottom:6px}
.stats{display:none;flex-direction:column;gap:2px}
.stat-row{display:grid;grid-template-columns:1fr auto;align-items:center;padding:5px 8px;background:white;border-radius:2px;border-left:2px solid transparent;transition:border-color .15s}
.stat-row:hover{border-left-color:var(--accent)}
.stat-label{font-size:10px;color:#666}
.stat-val{font-family:var(--mono);font-size:11px;color:var(--ink);font-weight:500}
.legend-strip{display:flex;flex-direction:column;gap:5px;padding:8px 10px;background:white;border-radius:3px;border:1px solid var(--faint)}
.leg-item{display:flex;align-items:center;gap:7px;font-size:10px;color:#444}
.leg-line{width:20px;height:2px;border-radius:1px;flex-shrink:0}
.note{font-size:10px;color:#666;line-height:1.6;padding:7px 9px;background:white;border-radius:3px;border:1px solid var(--faint);display:none;margin-top:6px}

/* MAIN AREA */
.main-area{background:var(--paper);display:flex;flex-direction:column;overflow:hidden;position:relative}

/* TABS */
.tabs{display:flex;background:var(--ink);border-bottom:1px solid #222}
.tab{font-family:var(--mono);font-size:10px;letter-spacing:2px;text-transform:uppercase;padding:10px 18px;color:#666;cursor:pointer;border-bottom:2px solid transparent;transition:color .15s,border-color .15s}
.tab.active{color:var(--paper);border-bottom-color:var(--accent)}
.tab:hover:not(.active){color:#aaa}

/* TAB PANELS */
.tab-panel{display:none;flex:1;overflow:hidden}
.tab-panel.active{display:flex;flex-direction:column;flex:1}

/* TEMPLATE PANEL */
.canvas-area{flex:1;display:flex;align-items:center;justify-content:center;padding:1.5rem;position:relative;overflow:hidden}
.canvas-area::before{content:'';position:absolute;inset:0;background-image:linear-gradient(var(--faint) 1px,transparent 1px),linear-gradient(90deg,var(--faint) 1px,transparent 1px);background-size:32px 32px;opacity:.5;pointer-events:none}
.canvas-wrap{position:relative;z-index:1;width:100%;max-width:780px;background:white;border:1px solid #ddd;border-radius:4px;box-shadow:0 4px 24px rgba(0,0,0,.08);overflow:hidden;display:none}
.canvas-toolbar{display:flex;justify-content:space-between;align-items:center;padding:8px 14px;background:var(--ink);flex-wrap:wrap;gap:6px}
.dots{display:flex;gap:5px;align-items:center}
.dot{width:8px;height:8px;border-radius:50%}
.dot-r{background:#ff5f57}.dot-y{background:#febc2e}.dot-g{background:#28c840}
.cvs-label{font-family:var(--mono);font-size:9px;letter-spacing:2px;color:#888;text-transform:uppercase;margin-left:6px}
.leg-inline{display:flex;gap:14px;flex-wrap:wrap}
.leg-i{display:flex;align-items:center;gap:4px;font-size:9px;color:#888;font-family:var(--mono)}
.leg-i-ln{width:14px;height:2px;border-radius:1px}
canvas#cvs{display:block;width:100%;background:#fafaf8}
.empty{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:1rem;color:#aaa;padding:3rem 2rem;text-align:center}
.empty-graphic{width:72px;height:72px;border:1.5px dashed #ccc;border-radius:50%;display:flex;align-items:center;justify-content:center}
.empty-graphic::after{content:'';width:36px;height:36px;border:1.5px dashed #ccc;border-radius:50%}
.empty h3{font-family:var(--display);font-size:20px;letter-spacing:3px;color:#bbb}
.empty p{font-size:12px;color:#bbb;line-height:1.7;max-width:240px}

/* MOCKUP PANEL */
.mockup-area{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden}
.mockup-area::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 60%,#e8e0d0 0%,var(--paper) 70%);pointer-events:none}
#three-canvas{position:relative;z-index:1;display:block}
.upload-zone{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:1rem;padding:2rem;text-align:center}
.upload-box{border:2px dashed var(--mid);border-radius:8px;padding:2rem 3rem;cursor:pointer;transition:border-color .2s,background .2s;background:rgba(255,255,255,.5)}
.upload-box:hover{border-color:var(--accent);background:rgba(200,68,26,.04)}
.upload-box input{display:none}
.upload-icon{font-size:32px;margin-bottom:.5rem;opacity:.4}
.upload-box p{font-size:12px;color:#777;line-height:1.6}
.upload-box strong{font-family:var(--mono);font-size:11px;color:var(--ink);display:block;margin-bottom:4px}
.mockup-controls{position:absolute;bottom:1rem;z-index:3;display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.ctrl-btn{font-family:var(--mono);font-size:9px;letter-spacing:1px;text-transform:uppercase;padding:5px 10px;background:rgba(10,10,10,.75);color:#ddd;border:1px solid #444;border-radius:2px;cursor:pointer;transition:background .15s}
.ctrl-btn:hover{background:rgba(10,10,10,.95);color:white}
.mockup-hint{position:absolute;top:1rem;z-index:3;font-family:var(--mono);font-size:9px;color:#aaa;letter-spacing:1px;text-transform:uppercase}
.no-template{display:flex;flex-direction:column;align-items:center;gap:.8rem;color:#bbb;padding:3rem;text-align:center}
.no-template h3{font-family:var(--display);font-size:20px;letter-spacing:3px}
.no-template p{font-size:12px;line-height:1.7;max-width:220px}
</style>
</head>
<body>

<header>
  <div style="display:flex;align-items:baseline">
    <div class="logo">Cup<span class="logo-accent">Forge</span></div>
    <div class="tagline">Frustum Unroll Template + 3D Mockup</div>
  </div>
  <div class="badges">
    <span class="badge">v3.0</span>
    <span class="badge">SVG · mm</span>
    <span class="badge">3D Mockup</span>
    <span class="badge">CorelDRAW Ready</span>
  </div>
</header>

<!-- SIDEBAR -->
<div class="sidebar">
  <div class="sidebar-inner">

    <div class="section">
      <div class="sec-header"><span class="sec-num">01</span><span class="sec-title">Ukuran Cup</span></div>
      <div class="field"><label>Diameter Atas <span class="unit">mm</span></label><input type="number" id="dTop" placeholder="cth. 80" min="1"></div>
      <div class="field"><label>Diameter Bawah <span class="unit">mm</span></label><input type="number" id="dBot" placeholder="cth. 60" min="1"></div>
      <div class="field"><label>Tinggi Cup <span class="unit">mm</span></label><input type="number" id="hCup" placeholder="cth. 100" min="1"></div>
    </div>

    <div class="section">
      <div class="sec-header"><span class="sec-num">02</span><span class="sec-title">Finishing</span></div>
      <div class="field"><label>Lebar Lem / Overlap <span class="unit">mm</span></label><input type="number" id="glue" placeholder="cth. 10" min="0"></div>
      <div class="field"><label>Bleed Semua Sisi <span class="unit">mm</span></label><input type="number" id="bleed" placeholder="cth. 3" min="0"></div>
    </div>

    <div class="section">
      <div class="errmsg" id="errMsg"></div>
      <button class="btn-generate" onclick="generate()">&#9654; Generate</button>
      <button class="btn-dl" id="dlBtn" onclick="downloadSVG()">&#8595; Download SVG</button>
      <div class="note" id="noteBox">SVG presisi satuan mm.<br>Import: <strong>File → Import</strong> atau drag &amp; drop ke CorelDRAW.</div>
    </div>

    <div class="section">
      <div class="sec-header"><span class="sec-num">03</span><span class="sec-title">Kalkulasi</span></div>
      <div class="stats" id="statsBox">
        <div class="stat-row"><span class="stat-label">Slant height (s)</span><span class="stat-val" id="v_slant">—</span></div>
        <div class="stat-row"><span class="stat-label">Radius luar (R)</span><span class="stat-val" id="v_bigR">—</span></div>
        <div class="stat-row"><span class="stat-label">Radius dalam (r)</span><span class="stat-val" id="v_smlR">—</span></div>
        <div class="stat-row"><span class="stat-label">Sudut busur (θ)</span><span class="stat-val" id="v_theta">—</span></div>
        <div class="stat-row"><span class="stat-label">Sudut area lem</span><span class="stat-val" id="v_glueA">—</span></div>
        <div class="stat-row"><span class="stat-label">Arc atas</span><span class="stat-val" id="v_arcT">—</span></div>
        <div class="stat-row"><span class="stat-label">Arc bawah</span><span class="stat-val" id="v_arcB">—</span></div>
      </div>
    </div>

    <div class="section">
      <div class="sec-header"><span class="sec-num">04</span><span class="sec-title">Keterangan</span></div>
      <div class="legend-strip">
        <div class="leg-item"><div class="leg-line" style="background:var(--cut)"></div>Cut Line — garis potong</div>
        <div class="leg-item"><div class="leg-line" style="background:var(--bleed)"></div>Bleed — lebihan cetak</div>
        <div class="leg-item"><div class="leg-line" style="background:var(--glue)"></div>Batas area lem</div>
      </div>
    </div>

  </div>
</div>

<!-- MAIN AREA -->
<div class="main-area">

  <!-- TABS -->
  <div class="tabs">
    <div class="tab active" onclick="switchTab('template')">&#9632; Template</div>
    <div class="tab" onclick="switchTab('mockup')" id="tab-mockup">&#9650; 3D Mockup</div>
  </div>

  <!-- TAB: TEMPLATE -->
  <div class="tab-panel active" id="panel-template">
    <div class="canvas-area">
      <div class="empty" id="emptyState">
        <div class="empty-graphic"></div>
        <h3>SIAP GENERATE</h3>
        <p>Masukkan dimensi cup lalu klik <strong>Generate</strong> untuk membuat template unroll.</p>
      </div>
      <div class="canvas-wrap" id="cvsBg">
        <div class="canvas-toolbar">
          <div style="display:flex;align-items:center">
            <div class="dots"><div class="dot dot-r"></div><div class="dot dot-y"></div><div class="dot dot-g"></div></div>
            <span class="cvs-label">Preview Template</span>
          </div>
          <div class="leg-inline">
            <div class="leg-i"><div class="leg-i-ln" style="background:var(--cut)"></div>Cut</div>
            <div class="leg-i"><div class="leg-i-ln" style="background:var(--bleed)"></div>Bleed</div>
            <div class="leg-i"><div class="leg-i-ln" style="background:var(--glue)"></div>Lem</div>
          </div>
        </div>
        <canvas id="cvs"></canvas>
      </div>
    </div>
  </div>

  <!-- TAB: 3D MOCKUP -->
  <div class="tab-panel" id="panel-mockup">
    <div class="mockup-area" id="mockupArea">

      <!-- No template yet -->
      <div class="no-template" id="noTemplate">
        <h3>GENERATE DULU</h3>
        <p>Generate template terlebih dahulu, lalu upload desain untuk melihat mockup 3D.</p>
      </div>

      <!-- Upload zone (shown after generate) -->
      <div class="upload-zone" id="uploadZone" style="display:none">
        <div class="upload-box" onclick="document.getElementById('fileInput').click()">
          <input type="file" id="fileInput" accept="image/*" onchange="handleUpload(event)">
          <div class="upload-icon">⬆</div>
          <strong>Upload Desain</strong>
          <p>JPG, PNG, atau file gambar lainnya<br>Akan di-wrap otomatis ke cup 3D</p>
        </div>
      </div>

      <!-- Three.js canvas -->
      <canvas id="three-canvas" style="display:none"></canvas>

      <div class="mockup-hint" id="mockupHint" style="display:none">DRAG untuk putar · SCROLL untuk zoom</div>

      <div class="mockup-controls" id="mockupControls" style="display:none">
        <button class="ctrl-btn" onclick="resetCamera()">Reset View</button>
        <button class="ctrl-btn" onclick="toggleBg()">Toggle BG</button>
        <button class="ctrl-btn" onclick="document.getElementById('fileInput').click()">Ganti Desain</button>
        <button class="ctrl-btn" onclick="saveRender()">Save PNG</button>
      </div>

    </div>
  </div>

</div>

<script>
const PI = Math.PI;
let lastData = null;
let threeSetup = null;
let bgDark = false;

/* ═══════════════════ TABS ═══════════════════ */
function switchTab(name){
  document.querySelectorAll('.tab').forEach((t,i)=>{
    t.classList.toggle('active', ['template','mockup'][i]===name);
  });
  document.querySelectorAll('.tab-panel').forEach((p,i)=>{
    p.classList.toggle('active', ['panel-template','panel-mockup'][i]==='panel-'+name);
  });
  if(name==='mockup' && threeSetup) threeSetup.renderer.setSize(threeSetup.container.clientWidth, threeSetup.container.clientHeight);
}

/* ═══════════════════ MATH ═══════════════════ */
function d2r(d){ return d*PI/180; }

function arcPts(radius,a0,a1,n){
  const pts=[];
  for(let i=0;i<=n;i++){
    const a=d2r(a0+(a1-a0)*i/n);
    pts.push([radius*Math.cos(a),radius*Math.sin(a)]);
  }
  return pts;
}

function calc(dTop,dBot,hCup,glue,bleed){
  const rTop=dTop/2,rBot=dBot/2;
  const slant=Math.sqrt(hCup*hCup+(rTop-rBot)*(rTop-rBot));
  const bigR=slant*rTop/(rTop-rBot);
  const smlR=Math.max(bigR-slant,0);
  const theta=360*rTop/bigR;
  const glueAngle=(glue/(2*PI*bigR))*360;
  const bleedAngle=(bleed/(2*PI*bigR))*360;
  const aStart=90-theta/2;
  const aEnd=90+theta/2+glueAngle;
  const glueStart=90+theta/2;
  const arcTop=(theta/360)*2*PI*bigR;
  const arcBot=(theta/360)*2*PI*smlR;
  return{slant,bigR,smlR,theta,glueAngle,bleedAngle,aStart,aEnd,glueStart,arcTop,arcBot};
}

function getPts(f,bleed){
  const N=Math.max(180,Math.round((f.theta/360)*400));
  return{
    inner:arcPts(f.smlR,f.aStart,f.aEnd,N),
    outer:arcPts(f.bigR,f.aStart,f.aEnd,N),
    bIn:arcPts(Math.max(f.smlR-bleed,0),f.aStart-f.bleedAngle,f.aEnd+f.bleedAngle,N),
    bOut:arcPts(f.bigR+bleed,f.aStart-f.bleedAngle,f.aEnd+f.bleedAngle,N)
  };
}

function bbox(p){
  const all=[...p.inner,...p.outer,...p.bIn,...p.bOut];
  return{
    minX:Math.min(...all.map(q=>q[0])),maxX:Math.max(...all.map(q=>q[0])),
    minY:Math.min(...all.map(q=>q[1])),maxY:Math.max(...all.map(q=>q[1]))
  };
}

/* ═══════════════════ GENERATE ═══════════════════ */
function generate(){
  const dTop=+document.getElementById('dTop').value;
  const dBot=+document.getElementById('dBot').value;
  const hCup=+document.getElementById('hCup').value;
  const glue=+document.getElementById('glue').value||0;
  const bleed=+document.getElementById('bleed').value||0;
  const err=document.getElementById('errMsg');
  err.style.display='none';

  if(!dTop||!dBot||!hCup||dTop<=0||dBot<=0||hCup<=0){
    err.textContent='Diameter dan tinggi harus diisi dan lebih dari 0!';err.style.display='block';return;
  }
  if(dTop<=dBot){
    err.textContent='Diameter atas harus lebih besar dari diameter bawah!';err.style.display='block';return;
  }

  const f=calc(dTop,dBot,hCup,glue,bleed);
  const p=getPts(f,bleed);
  lastData={f,p,bleed,dTop,dBot,hCup};

  const fmt=v=>v.toFixed(2);
  document.getElementById('v_slant').textContent=fmt(f.slant)+' mm';
  document.getElementById('v_bigR').textContent=fmt(f.bigR)+' mm';
  document.getElementById('v_smlR').textContent=fmt(f.smlR)+' mm';
  document.getElementById('v_theta').textContent=fmt(f.theta)+'°';
  document.getElementById('v_glueA').textContent=fmt(f.glueAngle)+'°';
  document.getElementById('v_arcT').textContent=fmt(f.arcTop)+' mm';
  document.getElementById('v_arcB').textContent=fmt(f.arcBot)+' mm';

  document.getElementById('statsBox').style.display='flex';
  document.getElementById('emptyState').style.display='none';
  document.getElementById('cvsBg').style.display='block';
  document.getElementById('dlBtn').style.display='block';
  document.getElementById('noteBox').style.display='block';
  document.getElementById('noTemplate').style.display='none';
  document.getElementById('uploadZone').style.display='flex';

  drawCanvas(f,p);
  if(threeSetup) buildCupGeometry(null);
}

/* ═══════════════════ CANVAS PREVIEW ═══════════════════ */
function drawCanvas(f,p){
  const bb=bbox(p);
  const W=bb.maxX-bb.minX,H=bb.maxY-bb.minY;
  const cvs=document.getElementById('cvs');
  const PAD=32,cvsW=760;
  const cvsH=Math.max(200,Math.round(cvsW*(H+PAD*2)/(W+PAD*2)));
  cvs.width=cvsW;cvs.height=cvsH;
  const sc=(cvsW-PAD*2)/W;
  const tx=x=>PAD+(x-bb.minX)*sc;
  const ty=y=>cvsH-PAD-(y-bb.minY)*sc;
  const ctx=cvs.getContext('2d');
  ctx.clearRect(0,0,cvsW,cvsH);
  ctx.fillStyle='#fafaf8';ctx.fillRect(0,0,cvsW,cvsH);
  ctx.strokeStyle='#eeebe5';ctx.lineWidth=0.5;
  const gs=Math.round(10*sc);
  for(let gx=PAD%gs;gx<cvsW;gx+=gs){ctx.beginPath();ctx.moveTo(gx,0);ctx.lineTo(gx,cvsH);ctx.stroke()}
  for(let gy=PAD%gs;gy<cvsH;gy+=gs){ctx.beginPath();ctx.moveTo(0,gy);ctx.lineTo(cvsW,gy);ctx.stroke()}

  function shape(inner,outer){
    ctx.beginPath();
    ctx.moveTo(tx(inner[0][0]),ty(inner[0][1]));
    for(let i=1;i<inner.length;i++)ctx.lineTo(tx(inner[i][0]),ty(inner[i][1]));
    ctx.lineTo(tx(outer[outer.length-1][0]),ty(outer[outer.length-1][1]));
    for(let i=outer.length-2;i>=0;i--)ctx.lineTo(tx(outer[i][0]),ty(outer[i][1]));
    ctx.closePath();
  }

  shape(p.bIn,p.bOut);
  ctx.fillStyle='rgba(45,122,79,.05)';ctx.fill();
  ctx.setLineDash([5,3]);ctx.strokeStyle='#2d7a4f';ctx.lineWidth=1;ctx.stroke();ctx.setLineDash([]);
  shape(p.inner,p.outer);
  ctx.fillStyle='rgba(200,68,26,.05)';ctx.fill();
  ctx.strokeStyle='#c8441a';ctx.lineWidth=1.5;ctx.stroke();
  const gr=d2r(f.glueStart);
  ctx.beginPath();
  ctx.moveTo(tx(f.smlR*Math.cos(gr)),ty(f.smlR*Math.sin(gr)));
  ctx.lineTo(tx(f.bigR*Math.cos(gr)),ty(f.bigR*Math.sin(gr)));
  ctx.strokeStyle='#1a5fa8';ctx.lineWidth=1.5;ctx.stroke();
}

/* ═══════════════════ SVG DOWNLOAD ═══════════════════ */
function toSP(x,y,minX,maxY,PAD){return[(x-minX+PAD).toFixed(4),(maxY-y+PAD).toFixed(4)]}

function ptsToPath(inner,outer,minX,maxY,PAD){
  let d='';
  inner.forEach((pt,i)=>{const[sx,sy]=toSP(pt[0],pt[1],minX,maxY,PAD);d+=(i===0?`M ${sx} ${sy}`:`L ${sx} ${sy}`)});
  for(let i=outer.length-1;i>=0;i--){const[sx,sy]=toSP(outer[i][0],outer[i][1],minX,maxY,PAD);d+=` L ${sx} ${sy}`}
  return d+' Z';
}

function downloadSVG(){
  if(!lastData)return;
  const{f,p,dTop,dBot,hCup}=lastData;
  const bb=bbox(p);const PAD=5;
  const svgW=(bb.maxX-bb.minX+PAD*2).toFixed(4);
  const svgH=(bb.maxY-bb.minY+PAD*2).toFixed(4);
  const dCut=ptsToPath(p.inner,p.outer,bb.minX,bb.maxY,PAD);
  const dBleed=ptsToPath(p.bIn,p.bOut,bb.minX,bb.maxY,PAD);
  const gr=d2r(f.glueStart);
  const[glx1,gly1]=toSP(f.smlR*Math.cos(gr),f.smlR*Math.sin(gr),bb.minX,bb.maxY,PAD);
  const[glx2,gly2]=toSP(f.bigR*Math.cos(gr),f.bigR*Math.sin(gr),bb.minX,bb.maxY,PAD);
  const svg=`<?xml version="1.0" encoding="UTF-8"?>
<!-- CupForge | Dia Atas:${dTop}mm | Dia Bawah:${dBot}mm | Tinggi:${hCup}mm -->
<svg xmlns="http://www.w3.org/2000/svg" width="${svgW}mm" height="${svgH}mm" viewBox="0 0 ${svgW} ${svgH}">
  <g id="Bleed"><path d="${dBleed}" fill="none" stroke="#2d7a4f" stroke-width="0.25" stroke-dasharray="2,1"/></g>
  <g id="Cut_Line"><path d="${dCut}" fill="none" stroke="#c8441a" stroke-width="0.25"/></g>
  <g id="Glue_Area"><line x1="${glx1}" y1="${gly1}" x2="${glx2}" y2="${gly2}" stroke="#1a5fa8" stroke-width="0.25"/></g>
</svg>`;
  const blob=new Blob([svg],{type:'image/svg+xml'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url;a.download=`cup_${dTop}x${dBot}x${hCup}mm.svg`;
  document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(url);
}

/* ═══════════════════ UPLOAD ═══════════════════ */
function handleUpload(e){
  const file=e.target.files[0];
  if(!file)return;
  const reader=new FileReader();
  reader.onload=ev=>{
    initThree(ev.target.result);
  };
  reader.readAsDataURL(file);
}

/* ═══════════════════ THREE.JS 3D MOCKUP ═══════════════════ */
function initThree(imageDataUrl){
  const container=document.getElementById('mockupArea');
  const W=container.clientWidth;
  const H=container.clientHeight;

  // cleanup old
  if(threeSetup){
    threeSetup.renderer.dispose();
    const old=document.getElementById('three-canvas');
    old.style.display='none';
  }

  const renderer=new THREE.WebGLRenderer({canvas:document.getElementById('three-canvas'),antialias:true,alpha:true});
  renderer.setPixelRatio(window.devicePixelRatio);
  renderer.setSize(W,H);
  renderer.shadowMap.enabled=true;
  renderer.shadowMap.type=THREE.PCFSoftShadowMap;
  document.getElementById('three-canvas').style.display='block';
  document.getElementById('uploadZone').style.display='none';
  document.getElementById('mockupHint').style.display='block';
  document.getElementById('mockupControls').style.display='flex';

  const scene=new THREE.Scene();
  scene.background=new THREE.Color(bgDark?'#1a1a1a':'#f0ebe3');

  const camera=new THREE.PerspectiveCamera(45,W/H,0.1,1000);
  camera.position.set(0,1,4);
  camera.lookAt(0,0,0);

  // Lights
  const ambient=new THREE.AmbientLight(0xffffff,0.5);
  scene.add(ambient);
  const dirLight=new THREE.DirectionalLight(0xffffff,0.9);
  dirLight.position.set(5,8,5);
  dirLight.castShadow=true;
  scene.add(dirLight);
  const fillLight=new THREE.DirectionalLight(0xffe8d0,0.3);
  fillLight.position.set(-3,2,-3);
  scene.add(fillLight);

  // Load texture from uploaded image
  const texLoader=new THREE.TextureLoader();
  const texture=texLoader.load(imageDataUrl);
  texture.wrapS=THREE.RepeatWrapping;
  texture.wrapT=THREE.ClampToEdgeWrapping;

  threeSetup={renderer,scene,camera,texture};
  buildCupGeometry(texture);
  setupOrbitControls(renderer,camera);
  animate();
}

function buildCupGeometry(texture){
  if(!lastData||!threeSetup)return;
  const{f}=lastData;
  const{scene}=threeSetup;

  // remove old cup
  const old=scene.getObjectByName('cup');
  if(old)scene.remove(old);

  // scale: 1 unit = 10mm
  const rTop=f.bigR/10*0.5; // approximate visual radius
  const rBot=f.smlR/10*0.5;
  // actual cup radii from input
  const RT=(lastData.dTop/2)/50;
  const RB=(lastData.dBot/2)/50;
  const H=lastData.hCup/50;

  const segs=128;
  const geo=new THREE.CylinderGeometry(RT,RB,H,segs,1,true);

  const mat=new THREE.MeshStandardMaterial({
    map: texture||null,
    color: texture?0xffffff:0xf5ede0,
    side:THREE.FrontSide,
    roughness:0.4,
    metalness:0.05
  });

  // UV fix: CylinderGeometry default UV wraps 0-1 horizontally
  // theta / 360 = fraction of full circle = the fraction we need
  const frac=f.theta/360;
  const uvAttr=geo.attributes.uv;
  for(let i=0;i<uvAttr.count;i++){
    const u=uvAttr.getX(i);
    uvAttr.setX(i, u*frac);
  }
  uvAttr.needsUpdate=true;

  const cup=new THREE.Mesh(geo,mat);
  cup.name='cup';
  cup.castShadow=true;

  // Top cap
  const topGeo=new THREE.CircleGeometry(RT,segs);
  const capMat=new THREE.MeshStandardMaterial({color:0xf0e8d8,roughness:0.6,metalness:0});
  const topCap=new THREE.Mesh(topGeo,capMat);
  topCap.rotation.x=-PI/2;
  topCap.position.y=H/2;

  // Bottom cap
  const botGeo=new THREE.CircleGeometry(RB,segs);
  const botCap=new THREE.Mesh(botGeo,capMat);
  botCap.rotation.x=PI/2;
  botCap.position.y=-H/2;

  const group=new THREE.Group();
  group.add(cup,topCap,botCap);
  group.name='cup';
  group.rotation.y=PI/4;
  threeSetup.scene.add(group);

  // Floor shadow plane
  let floor=threeSetup.scene.getObjectByName('floor');
  if(!floor){
    const fGeo=new THREE.PlaneGeometry(20,20);
    const fMat=new THREE.ShadowMaterial({opacity:0.12});
    floor=new THREE.Mesh(fGeo,fMat);
    floor.name='floor';
    floor.rotation.x=-PI/2;
    floor.position.y=-H/2-0.01;
    floor.receiveShadow=true;
    threeSetup.scene.add(floor);
  }else{
    floor.position.y=-H/2-0.01;
  }
}

/* ═══════════════════ ORBIT CONTROLS (manual) ═══════════════════ */
function setupOrbitControls(renderer,camera){
  const el=renderer.domElement;
  let isDragging=false,lastX=0,lastY=0;
  let rotX=0.15,rotY=PI/4,zoom=4;

  function updateCamera(){
    camera.position.x=zoom*Math.sin(rotY)*Math.cos(rotX);
    camera.position.y=zoom*Math.sin(rotX)+0.5;
    camera.position.z=zoom*Math.cos(rotY)*Math.cos(rotX);
    camera.lookAt(0,0,0);
  }

  el.addEventListener('mousedown',e=>{isDragging=true;lastX=e.clientX;lastY=e.clientY});
  window.addEventListener('mouseup',()=>isDragging=false);
  window.addEventListener('mousemove',e=>{
    if(!isDragging)return;
    rotY+=(e.clientX-lastX)*0.008;
    rotX+=(e.clientY-lastY)*0.005;
    rotX=Math.max(-0.3,Math.min(1.2,rotX));
    lastX=e.clientX;lastY=e.clientY;
    updateCamera();
  });
  el.addEventListener('wheel',e=>{
    zoom=Math.max(1.5,Math.min(8,zoom+e.deltaY*0.005));
    updateCamera();e.preventDefault();
  },{passive:false});

  // touch
  let lastTouchDist=null,lastTouchX=0,lastTouchY=0;
  el.addEventListener('touchstart',e=>{
    if(e.touches.length===1){lastTouchX=e.touches[0].clientX;lastTouchY=e.touches[0].clientY}
    if(e.touches.length===2){lastTouchDist=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY)}
  });
  el.addEventListener('touchmove',e=>{
    if(e.touches.length===1){
      rotY+=(e.touches[0].clientX-lastTouchX)*0.01;
      rotX+=(e.touches[0].clientY-lastTouchY)*0.006;
      rotX=Math.max(-0.3,Math.min(1.2,rotX));
      lastTouchX=e.touches[0].clientX;lastTouchY=e.touches[0].clientY;
      updateCamera();
    }
    if(e.touches.length===2){
      const d=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
      zoom=Math.max(1.5,Math.min(8,zoom-(d-lastTouchDist)*0.01));
      lastTouchDist=d;updateCamera();
    }
    e.preventDefault();
  },{passive:false});

  threeSetup.updateCamera=updateCamera;
  threeSetup.resetState=()=>{rotX=0.15;rotY=PI/4;zoom=4;updateCamera()};
  updateCamera();
}

function animate(){
  if(!threeSetup)return;
  requestAnimationFrame(animate);
  threeSetup.renderer.render(threeSetup.scene,threeSetup.camera);
}

function resetCamera(){
  if(threeSetup&&threeSetup.resetState)threeSetup.resetState();
}

function toggleBg(){
  bgDark=!bgDark;
  if(threeSetup)threeSetup.scene.background=new THREE.Color(bgDark?'#1a1a1a':'#f0ebe3');
}

function saveRender(){
  if(!threeSetup)return;
  threeSetup.renderer.render(threeSetup.scene,threeSetup.camera);
  const url=threeSetup.renderer.domElement.toDataURL('image/png');
  const a=document.createElement('a');a.href=url;a.download='cup_mockup_3d.png';
  document.body.appendChild(a);a.click();document.body.removeChild(a);
}

// resize
window.addEventListener('resize',()=>{
  if(!threeSetup)return;
  const c=document.getElementById('mockupArea');
  threeSetup.renderer.setSize(c.clientWidth,c.clientHeight);
  threeSetup.camera.aspect=c.clientWidth/c.clientHeight;
  threeSetup.camera.updateProjectionMatrix();
});
</script>
